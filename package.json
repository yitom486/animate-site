{
  "name": "start",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "wrangler pages dev ./build/client",
    "typecheck": "react-router typegen && tsc",
    "fmt": "oxfmt .",
    "lint": "oxlint .",
    "check:theme": "bun run scripts/check-ui-theme.ts",
    "check:cache": "bun run scripts/check-cache.ts",
    "check:queries": "bun run scripts/check-client-queries.ts",
    "check:news": "bun run scripts/check-news.ts",
    "news:migrate:local": "wrangler d1 migrations apply NEWS_DB --local",
    "news:sync:local": "bun run scripts/sync-news-local.ts",
    "news:worker:build": "wrangler deploy --dry-run --minify --config workers/news-sync/wrangler.toml --outdir ../../.wrangler/news-worker",
    "data:bangumi": "bun run scripts/update-bangumi-data.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@react-router/cloudflare": "7.17.0",
    "@tanstack/react-query": "^5.106.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "entities": "^9.0.0",
    "fast-xml-parser": "^5.12.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.17.0",
    "motion": "^14.9.1",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.6",
    "react-router": "7.17.0",
    "sanitize-html": "^2.17.5",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@react-router/dev": "7.17.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.100.0"
  },
  "packageManager": "bun@1.3.14"
}
